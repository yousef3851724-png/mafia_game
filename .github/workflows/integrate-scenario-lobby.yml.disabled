name: Integrate Scenario Lobby

on:
  push:
    branches:
      - main

permissions:
  contents: write

jobs:
  integrate:
    if: "!contains(github.event.head_commit.message, 'integrate: scenario lobby')"
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: Connect scenario lobby to app entry
        shell: python
        run: |
          from pathlib import Path

          path = Path('lib/main.dart')
          text = path.read_text(encoding='utf-8')

          import_line = "import 'features/scenarios/scenario_lobby_screen.dart';\n"
          if import_line not in text:
              marker = "import 'package:shared_preferences/shared_preferences.dart';\n"
              text = text.replace(marker, marker + import_line, 1)

          old = "home: const LobbyScreen(),"
          new = "home: const ScenarioLobbyScreen(ownerId: 'local_creator'),"
          if old in text and 'ScenarioLobbyScreen(ownerId:' not in text:
              text = text.replace(old, new, 1)

          path.write_text(text, encoding='utf-8')

      - name: Commit integration
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "41898282+github-actions[bot]@users.noreply.github.com"
          git add lib/main.dart
          if git diff --cached --quiet; then
            echo "Scenario lobby is already integrated."
            exit 0
          fi
          git commit -m "integrate: scenario lobby"
          git push
