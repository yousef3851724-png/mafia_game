{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-radical-hyperdrive-test",
  "main": "src/postgres-index.js",
  "compatibility_date": "2026-11-28",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "REPLACE_WITH_HYPERDRIVE_CONFIG_ID"
    }
  ]
}
