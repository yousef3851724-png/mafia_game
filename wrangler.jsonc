{
  "name": "mafia-radical",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "mafia-radical-db",
      "database_id": "05333b38-bcb1-4775-a995-0d3a8c652501"
    }
  ]
}
