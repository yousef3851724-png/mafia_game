{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mafia-radical",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": [
      "/health",
      "/api/*",
      "/lobby*"
    ]
  }
}
