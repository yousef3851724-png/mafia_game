  Player copyWith({
    String? id,
    String? name,
    String? role,
    bool? isAlive,
    int? votesReceived,
  }) {
    return Player(
      id: id ?? this.id,
      name: name ?? this.name,
      role: role ?? this.role,
      isAlive: isAlive ?? this.isAlive,
      votesReceived: votesReceived ?? this.votesReceived,
